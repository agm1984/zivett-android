<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below. Backup is disabled outright in the manifest
     (allowBackup="false"); these rules make the intent explicit if that
     is ever flipped: nothing leaves the device — the Sanctum token lives
     in SharedPreferences under a KeyStore-wrapped key, and the KeyStore
     key itself never restores, so a restored token would be unreadable
     anyway. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
